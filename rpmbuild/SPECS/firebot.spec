# firebot (Firebot v5) — repackaged from the official upstream binary rpm.
# Update procedure: bump Version, update the sha256 comment, rebuild.

# Prebuilt stripped Electron binaries — nothing to debug-extract.
%global debug_package %{nil}

# Upstream's own binary package name (firebotv5), kept for the
# desktop file / icons / libexec dir; we ship our own package name.
%global appname firebotv5

Name:           firebot
Version:        5.66.7
Release:        1%{?dist}
Summary:        Powerful all-in-one bot for Twitch streamers

License:        GPL-3.0-only AND MIT AND BSD-3-Clause
URL:            https://firebot.app
Source0:        https://github.com/crowbartools/Firebot/releases/download/v%{version}/firebot-v%{version}-linux-x64.rpm
# sha256(Source0) = c8dd58f5f632d716f37bb6b60701853b74c08e201c87f089fd9a8ca602cbcc9e

BuildArch:      x86_64
BuildRequires:  cpio

# ELF auto-dependencies cover the bundled libraries; these are the
# non-library bits Electron apps need.
Requires:       xdg-utils
Requires:       hicolor-icon-theme

%description
Firebot is a powerful all-in-one bot for Twitch streamers. It features
a chat moderation tool, custom commands, timers, alerts, overlays and
more. This package repackages the official upstream rpm so it can be
managed with dnf.

%prep
%setup -q -T -c -n %{name}-%{version}

# Unpack the upstream binary rpm into the build directory.
rpm2cpio %{SOURCE0} | cpio -idmu --quiet

# Drop the build-id symlinks of the repacked binaries; they would
# pollute the build-id namespace and are regenerated by find-debuginfo
# for anything built from source anyway (debuginfo is disabled here).
rm -rf ./usr/lib/.build-id

# The main Electron binary is called "Firebot v5" (with a space). rpm
# %files lists cannot reference it ("File must begin with /" breakage
# from the space splitting the path), so rename it and fix the /usr/bin
# wrapper symlink to point at the new name.
mv "./usr/lib/%{appname}/Firebot v5" ./usr/lib/%{appname}/firebot
ln -sfn ../lib/%{appname}/firebot ./usr/bin/%{appname}

# Stray LICENSE file the upstream packager dropped in the applications
# dir (likely a fzf entry in their electron-builder config); the
# desktop-file whitelist of /usr/share/applications doesn't expect it.
rm -f ./usr/share/applications/LICENSE

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}
cp -a . %{buildroot}

# Don't let check-rpaths fail on the upstream binaries' vendor rpaths
# (bitmask: standard | invalid | $ORIGIN-position | empty).
export QA_RPATHS=$(( 0x0001 | 0x0002 | 0x0008 | 0x0010 ))

# Regenerate the %files list from the extracted tree, skipping
# directories owned by the "filesystem" package.
cat > std-dirs <<'EOF'
/bin
/etc
/etc/opt
/opt
/usr
/usr/bin
/usr/lib
/usr/lib64
/usr/libexec
/usr/local
/usr/sbin
/usr/share
/usr/share/applications
/usr/share/appdata
/usr/share/doc
/usr/share/icons
/usr/share/icons/hicolor
/usr/share/licenses
/usr/share/metainfo
/usr/share/mime
/usr/share/mime-info
/usr/share/pixmaps
/var
EOF
find %{buildroot} -mindepth 1 -printf '/%%P\n' \
    | grep -Fvx -f std-dirs > %{name}.files

%files -f %{_builddir}/%{name}-%{version}/%{name}.files
%defattr(-,root,root,-)

%post
/bin/touch --no-create %{_datadir}/icons/hicolor 2>/dev/null || :

%postun
if [ $1 -eq 0 ]; then
    /bin/touch --no-create %{_datadir}/icons/hicolor 2>/dev/null || :
    gtk-update-icon-cache -qtf %{_datadir}/icons/hicolor 2>/dev/null || :
    update-desktop-database -q 2>/dev/null || :
fi

%changelog
* Sun Nov 01 2026 Noel Knubel - 5.66.7-1
- Initial repack of the official upstream rpm for COPR.
